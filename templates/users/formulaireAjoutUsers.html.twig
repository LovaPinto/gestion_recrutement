{% extends 'layout/layout_frontend/sidebar.html.twig' %}
{% set menus = ['dashboard','departement','utilisateur'] %}

{% block body %}
<div class="container">

<h2 class="title">Gestion des Ressources Humaines</h2>

<div class="grid">

<!-- ================= LISTE RH ================= -->
<div class="card list">
<h3>Liste des Ressources Humaines</h3>

{% for u in users %}
<div class="rh-row">

<form method="post" class="row">
    <input type="hidden" name="edit_id" value="{{ u.id }}">

    <input name="firstName" value="{{ u.firstName }}" required>
    <input name="lastName" value="{{ u.lastName }}" required>
    <input name="email" value="{{ u.email }}" required>

    <button class="btn save">✔</button>
</form>

<form method="post"
      onsubmit="return confirm('Voulez-vous vraiment supprimer {{ u.firstName }} {{ u.lastName }} ?');">
    <input type="hidden" name="delete_id" value="{{ u.id }}">
    <button class="btn delete">🗑</button>
</form>

</div>
{% else %}
<p class="empty">Aucun RH enregistré</p>
{% endfor %}
</div>

<!-- ================= AJOUT RH (FIXE) ================= -->
<div class="card form-card">
<h3>Ajouter un RH</h3>

{{ form_start(form, {
    attr: {
        autocomplete: 'off',
        id: 'rhForm'
    }
}) }}

<div class="form-group">
    {{ form_widget(form.firstName, {'attr': {'placeholder':'Prénom','autocomplete':'off'}}) }}
</div>

<div class="form-group">
    {{ form_widget(form.lastName, {'attr': {'placeholder':'Nom','autocomplete':'off'}}) }}
</div>

<div class="form-group">
    {{ form_widget(form.email, {'attr': {'placeholder':'Adresse email','autocomplete':'off'}}) }}
</div>

<div class="form-group">
    {{ form_widget(form.password, {'attr': {'placeholder':'Mot de passe','autocomplete':'new-password'}}) }}
</div>

<button class="btn primary full">Ajouter le RH</button>

{{ form_end(form) }}
</div>

</div>
</div>

<!-- ================= ALERTS (FLASH) ================= -->
{% for message in app.flashes('success') %}
<div class="overlay">
    <div class="alert success">
        <div class="icon">✔</div>
        <p>{{ message }}</p>
    </div>
</div>
{% endfor %}

{% for message in app.flashes('error') %}
<div class="overlay">
    <div class="alert error">
        <div class="icon">✖</div>
        <p>{{ message }}</p>
    </div>
</div>
{% endfor %}

<script>
// reset visuel du formulaire (sécurité UX)
document.getElementById('rhForm')?.addEventListener('submit', () => {
    setTimeout(() => {
        document.getElementById('rhForm').reset();
    }, 100);
});

// auto close alert
setTimeout(() => {
    document.querySelector('.overlay')?.remove();
}, 2200);
</script>

<style>
/* ===== BASE ===== */
* {
    box-sizing:border-box;
    font-family:Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
}

body {
    background:#f4f6f8;
}

/* ===== CONTAINER ===== */
.container {
    padding:40px;
}

.title {
    font-size:26px;
    font-weight:700;
    margin-bottom:30px;
}

/* ===== GRID ===== */
.grid {
    display:grid;
    grid-template-columns:2fr 1fr;
    gap:32px;
    align-items:start;
}

/* ===== CARD ===== */
.card {
    background:#fff;
    border-radius:12px;
    padding:28px;
    border:1px solid #e5e7eb;
}

/* Liste RH scrollable */
.card.list {
    max-height:calc(100vh - 160px);
    overflow-y:auto;
}

/* Formulaire fixe */
.form-card {
    position:sticky;
    top:30px;
}

/* ===== LISTE RH ===== */
.rh-row {
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:14px;
}

.row {
    display:grid;
    grid-template-columns:1fr 1fr 2fr auto;
    gap:10px;
    flex:1;
}

/* ===== INPUT ===== */
input {
    width:100%;
    padding:10px 12px;
    border-radius:8px;
    border:1px solid #d1d5db;
    font-size:14px;
}

input:focus {
    outline:none;
    border-color:#111;
}

/* ===== FORM ===== */
.form-group {
    margin-bottom:18px;
}

.form-group input {
    height:42px;
}

/* ===== BUTTONS ===== */
.btn {
    border:none;
    border-radius:8px;
    padding:9px 14px;
    cursor:pointer;
    font-weight:600;
}

.btn.save {
    background:#111;
    color:#fff;
}

.btn.delete {
    background:#fff;
    border:1px solid #d1d5db;
}

.btn.primary {
    background:#111;
    color:#fff;
}

.btn.full {
    width:100%;
}

/* ===== EMPTY ===== */
.empty {
    text-align:center;
    color:#6b7280;
}

/* ===== ALERT ===== */
.overlay {
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.55);
    display:flex;
    justify-content:center;
    align-items:center;
    z-index:9999;
}

.alert {
    background:#fff;
    padding:28px 34px;
    border-radius:14px;
    text-align:center;
}

.alert .icon {
    font-size:38px;
    margin-bottom:10px;
}

.alert.success .icon { color:#16a34a }
.alert.error .icon { color:#dc2626 }
</style>
{% endblock %}
