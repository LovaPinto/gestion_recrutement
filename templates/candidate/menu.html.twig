<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        {% block title %}
            Nextwork - {{ app.session.get('last_name') ?? 'Candidat' }}
        {% endblock %}
    </title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- CSS -->
    <link rel="stylesheet" href="{{ asset('styles/menu.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/profil.css') }}">

    {% block stylesheets %}{% endblock %}
</head>

<body>

<!-- ================= SIDEBAR ================= -->
<nav class="sidebar">
    <div class="sidebar-header">
        <h2 class="sidebar-title">Nextwork</h2>
    </div>

    {% set currentRoute = app.request.attributes.get('_route') %}

    <ul class="nav-menu">
        <li class="nav-item">
            <a href="{{ path('app_candidate_dashboard') }}"
               class="nav-link {{ currentRoute == 'app_candidate_dashboard' ? 'active' }}">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
        </li>

        <li class="nav-item">
            <a href="{{ path('app_job_offer') }}"
               class="nav-link {{ currentRoute starts with 'app_job_offer' ? 'active' }}">
                <i class="fas fa-briefcase"></i>
                <span>Voir les offres</span>
            </a>
        </li>

        <li class="nav-item">
            <a href="{{ path('app_candidate_index') }}"
               class="nav-link {{ currentRoute starts with 'app_candidate_index' ? 'active' }}">
                <i class="fas fa-file-alt"></i>
                <span>Mes candidatures</span>
            </a>
        </li>

        <li class="nav-item">
            <a href="{{ path('app_candidate_profil') }}"
               class="nav-link {{ currentRoute == 'app_candidate_profil' ? 'active' }}">
                <i class="fas fa-user"></i>
                <span>Mon profil</span>
            </a>
        </li>

        <li class="nav-item">
            <a href="{{ path('app_logout') }}" class="nav-link text-danger">
                <i class="fas fa-sign-out-alt"></i>
                <span>Déconnexion</span>
            </a>
        </li>
    </ul>
</nav>

<!-- ================= MAIN ================= -->
<div class="main-wrapper">

    <!-- Header -->
    <header class="top-header">
        <div class="header-left">
            <i class="fas fa-bars toggle-sidebar"></i>
            <span class="breadcrumb-text">Espace candidat</span>
        </div>

        <div class="header-right">
            <div class="user-profile">
                <div class="user-avatar">
                    {{ app.session.get('last_name') ? app.session.get('last_name')|first|upper : 'C' }}
                </div>
                <span class="user-name">
                    {{ app.session.get('first_name') ?? '' }}
                    {{ app.session.get('last_name') ?? 'Candidat' }}
                </span>
                <i class="fas fa-cog settings-icon"></i>
            </div>
        </div>
    </header>

    <!-- Content -->
    <main class="page-content">
        {% block content %}{% endblock %}
    </main>
</div>

<!-- ================= JS ================= -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.querySelector('.toggle-sidebar')?.addEventListener('click', () => {
        document.querySelector('.sidebar')?.classList.toggle('active');
    });
</script>

{% block extra_js %}{% endblock %}

</body>
</html>
