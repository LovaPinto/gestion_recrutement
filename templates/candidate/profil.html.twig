{% extends 'candidate/menu.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/profil.css') }}">
{% endblock %}

{% block content %}
<div class="container profile-container mt-4">

    <h2 class="profile-title mb-4">Mon profil</h2>

    {# ================= FLASH ================= #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="profile-card card shadow-sm">
        <div class="card-body">

            {{ form_start(form, {
                method: 'POST',
                attr: { class: 'needs-validation' },
                enctype: 'multipart/form-data'
            }) }}

            {# ================= IDENTITÉ ================= #}
            <h5 class="mb-3">Informations personnelles</h5>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    {{ form_row(form.nom) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.prenom) }}
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    {{ form_row(form.email, {
                        attr: {
                            class: 'form-control',
                            readonly: true
                        }
                    }) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.telephone) }}
                </div>
            </div>

            {{ form_row(form.adresse) }}

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    {{ form_row(form.nationalite) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.genre) }}
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    {{ form_row(form.dateNaissance) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.status) }}
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    {{ form_row(form.linkedin) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.facebook) }}
                </div>
            </div>

            <hr class="my-4">

            {# ================= DOCUMENTS ================= #}
            <h5 class="mb-3">Documents</h5>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    {{ form_row(form.cvFile) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.lmFile) }}
                </div>
            </div>

            {{ form_rest(form) }}

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="{{ path('app_candidate_dashboard') }}" class="btn btn-outline-secondary">
                    Annuler
                </a>
                <button type="submit" class="btn btn-primary">
                    Enregistrer les modifications
                </button>
            </div>

            {{ form_end(form) }}

        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
