{% extends 'layout/layout_frontend/connexionDepart.html.twig' %}

{% block title %}Connexion Candidat{% endblock %}

{% block auth_content %}

<h2>Ravi de te revoir !</h2>

<form method="post" action="{{ path('candidat_login') }}">
    <input type="email" name="email" placeholder="Email" required>

    <div class="password-field">
        <input type="password" name="password" placeholder="Mot de passe" required>
    </div>

    <button class="btn-primary">Se connecter</button>
</form>

<p class="register">
    Vous n'avez pas encore de compte ?
    <a href="{{ path('candidat_signup') }}">Créer un compte</a>
</p>

<a class="forgot" href="#">Mot de passe oublié ?</a>

{# ================= LOGIN SUCCÈS ================= #}
{% if loginSuccess is defined %}
<div id="statusOverlay">
    <div class="status-box success">
        <div class="circle-rotating">
            <div class="check">✔</div>
        </div>
        <span>Succès</span>
        <small>Connexion réussie</small>
    </div>
</div>
{% endif %}

{# ================= LOGIN ERREUR ================= #}
{% if loginError is defined %}
<div id="statusOverlay">
    <div class="status-box error">
        <div class="cross">✖</div>
        <span>Erreur</span>
        <small>Vérifiez votre identifiant ou mot de passe</small>
    </div>
</div>
{% endif %}

{# ================= LOGOUT ================= #}
{% if logoutSuccess is defined %}
<div id="statusOverlay">
    <div class="status-box logout">
        <div class="logout-icon">
            <i class="fa-solid fa-right-from-bracket"></i>
        </div>
        <span>Session terminée</span>
        <small>
            Veuillez vous reconnecter pour continuer.
        </small>
    </div>
</div>
{% endif %}




{# ================= JS ================= #}
<script>
document.addEventListener('DOMContentLoaded', () => {

    {% if loginSuccess is defined %}
        setTimeout(() => {
            window.location.href = "{{ path('app_candidate_dashboard') }}";
        }, 2000);
    {% endif %}

    {% if loginError is defined %}
        setTimeout(() => {
            document.getElementById('statusOverlay')?.remove();
        }, 1500);
    {% endif %}

    {% if logoutSuccess is defined %}
        setTimeout(() => {
            document.getElementById('statusOverlay')?.remove();
        }, 2000);
    {% endif %}

});
</script>

{# ================= CSS ================= #}
<style>
#statusOverlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,0.55);
    display:flex;
    justify-content:center;
    align-items:center;
    z-index:9999;
    font-family:'Segoe UI',sans-serif;
}

.status-box{
    width:240px;
    background:#fff;
    padding:22px;
    border-radius:10px;
    text-align:center;
    box-shadow:0 10px 25px rgba(0,0,0,.25);
}

.status-box span{
    display:block;
    margin-top:10px;
    font-weight:600;
}

.status-box small{
    display:block;
    margin-top:6px;
    font-size:13px;
    color:#555;
}

/* ===== SUCCESS ===== */
.status-box.success span{
    color:#2e7d32;
}

.check{
    font-size:40px;
    color:#4CAF50;
    font-weight:bold;
}

/* cercle tournant */
.circle-rotating{
    width:80px;
    height:80px;
    border-radius:50%;
    border:4px solid #4CAF50;
    border-top-color:transparent;
    display:flex;
    justify-content:center;
    align-items:center;
    animation:rotate 2s linear;
    margin:auto;
}

/* ===== ERROR ===== */
.status-box.error span{
    color:#e53935;
}

.cross{
    font-size:40px;
    color:#e53935;
}

/* ===== ANIMATION ===== */
@keyframes rotate{
    from{transform:rotate(0deg)}
    to{transform:rotate(360deg)}
}
/* ===== LOGOUT (flèche sortante) ===== */

.status-box.logout span{
    color:#444;
    font-weight:600;
}

.logout-icon i{
    font-size:42px;
    color:#ff9800;
    margin-bottom:10px;
}


@keyframes slideOut{
    from{ transform:translateX(0); opacity:1 }
    to{ transform:translateX(10px); opacity:1 }
}


</style>

{% endblock %}
