{% extends 'layout/layout_frontend/layoutDepart.html.twig' %}

{% block title %}
Postuler – {{ jobOffer.title }}
{% endblock %}

{% block body %}
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');

/* ================= BASE ================= */
body {
    font-family: 'Inter', sans-serif;
    background: #ffffff;
    color: #000;
}

/* ================= ALERT ================= */
#alert-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.55);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
}

.alert-card {
    position: relative;
    background: #fff;
    padding: 46px 56px 40px;
    border-radius: 22px;
    width: 420px;
    text-align: center;
    animation: scaleIn .3s ease;
}

/* ICON */
.alert-icon {
    font-size: 56px;
    font-weight: 800;
    position: relative;
    z-index: 3;
    margin-top: -6px; /* ⬅️ montée */
}

/* RING */
.ring {
    position: absolute;
    width: 118px;
    height: 118px;
    top: 26px;        /* ⬅️ montée */
    left: 50%;
    transform: translateX(-50%);
    border-radius: 50%;
    border: 3px solid #fff;
    z-index: 2;
}

/* WATER */
.ring::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background:
        conic-gradient(
            transparent 0deg,
            transparent 310deg,
            #9ca3af 330deg,
            #9ca3af 350deg,
            transparent 360deg
        );
    animation: waterFlow 1.6s linear infinite;
    mask: radial-gradient(
        farthest-side,
        transparent calc(100% - 6px),
        #000 calc(100% - 3px)
    );
}

/* TEXT */
.alert-text {
    margin-top: 26px;
    font-size: 16px;
    font-weight: 600;
}

/* ================= FORM BOX ================= */
.apply-box {
    max-width: 760px;
    margin: 60px auto;
    padding: 46px 42px;
    background: #fff;
    border-radius: 18px;
    border: 1px solid #e5e7eb;
}

.apply-box h2 {
    text-align: center;
    font-size: 26px;
    font-weight: 700;
}

.apply-box p {
    text-align: center;
    color: #6b7280;
    margin-bottom: 36px;
}

/* ================= USER INFO ================= */
.user-info {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
    gap: 18px;
    margin-bottom: 36px;
}

.user-card {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 14px 16px;
}

.user-card span {
    font-size: 12px;
    color: #6b7280;
    font-weight: 600;
}

.user-card div {
    margin-top: 4px;
}

/* ================= FORM ================= */
.form-group { margin-bottom: 22px; }

label {
    font-weight: 600;
    margin-bottom: 8px;
    display: block;
}

input, textarea {
    width: 100%;
    padding: 14px;
    border-radius: 12px;
    border: 1px solid #d1d5db;
}

textarea { min-height: 130px; }

input[readonly] { background: #f3f4f6; }

/* ================= FILE INPUT (UNIFIED) ================= */
.file-wrapper {
    display: flex;
    gap: 12px;
}

.file-btn {
    background: #000;
    color: #fff;
    padding: 12px 18px;
    border-radius: 12px;
    cursor: pointer;
    border: none;
    font-weight: 600;
}

.file-name {
    flex: 1;
    padding: 12px;
    border-radius: 12px;
    background: #f9fafb;
    border: 1px solid #d1d5db;
    font-size: 14px;
}

/* SUBMIT */
.btn-apply {
    width: 100%;
    margin-top: 20px;
    padding: 16px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 14px;
    font-weight: 700;
    cursor: pointer;
}

/* ANIM */
@keyframes waterFlow { to { transform: rotate(360deg); } }
@keyframes scaleIn {
    from { transform: scale(.85); opacity: 0 }
    to   { transform: scale(1); opacity: 1 }
}
</style>

{# ================= ALERT ================= #}
{% if result is defined %}
<div id="alert-overlay">
    <div class="alert-card {{ result }}">
        {% if result == 'success' %}
            <div class="ring"></div>
        {% endif %}
        <div class="alert-icon">
            {{ result == 'success' ? '✓' : '✕' }}
        </div>
        <div class="alert-text">{{ message }}</div>
    </div>
</div>
{% endif %}

{# ================= FORM ================= #}
<div class="apply-box">

    <h2>Postuler à : {{ jobOffer.title }}</h2>
    <p>{{ jobOffer.company.companyName }} • {{ jobOffer.department.departmentName }}</p>

    <div class="user-info">
        <div class="user-card"><span>Prénom</span><div>{{ user.firstname }}</div></div>
        <div class="user-card"><span>Nom</span><div>{{ user.lastname }}</div></div>
        <div class="user-card"><span>Email</span><div>{{ user.email }}</div></div>
    </div>

    <form method="POST" enctype="multipart/form-data">

        <div class="form-group">
            <label>Date de candidature</label>
            <input type="date" value="{{ 'now'|date('Y-m-d') }}" readonly>
        </div>

        <div class="form-group">
            <label>CV</label>
            <div class="file-wrapper">
                <button type="button" class="file-btn" onclick="cv.click()">Choisir</button>
                <span class="file-name" id="cv-name">Aucun fichier</span>
                <input type="file" name="cv_path" id="cv" hidden required
                       onchange="cvName.textContent=this.files[0]?.name || 'Aucun fichier'">
            </div>
        </div>

        <div class="form-group">
            <label>Pièce jointe (optionnel)</label>
            <div class="file-wrapper">
                <button type="button" class="file-btn" onclick="att.click()">Choisir</button>
                <span class="file-name" id="att-name">Aucun fichier</span>
                <input type="file" name="attachement" id="att" hidden
                       onchange="attName.textContent=this.files[0]?.name || 'Aucun fichier'">
            </div>
        </div>

        <div class="form-group">
            <label>Portfolio (lien)</label>
            <input type="url" name="portfolio_link">
        </div>

        <div class="form-group">
            <label>Message / Motivation</label>
            <textarea name="reason"></textarea>
        </div>

        <button class="btn-apply">Envoyer ma candidature</button>
    </form>
</div>

<script>
const cvName  = document.getElementById('cv-name');
const attName = document.getElementById('att-name');

document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('alert-overlay');
    if (!overlay) return;

    {% if result is defined and result == 'success' %}
        setTimeout(() => {
            window.location.href = "{{ path('app_candidate_dashboard') }}";
        }, 2200);
    {% elseif result is defined %}
        setTimeout(() => overlay.remove(), 1800);
    {% endif %}
});
</script>
{% endblock %}
