{% extends 'layout/layout_frontend/layoutDepart.html.twig' %}

{% block title %}
Validation de l'offre - {{ offer.title }}
{% endblock %}

{% block body %}

{# ===== ALERT ANIMÉE ===== #}
{% if result is defined %}
<div id="alert-overlay">
    <div class="alert-box {{ result }}">
        {% if result == 'success' %}
            <div class="loader-circle"></div>
            <div class="icon success">✔</div>
        {% else %}
            <div class="icon error">✖</div>
        {% endif %}
        <p class="alert-message">{{ message }}</p>
    </div>
</div>
{% endif %}

<div class="pending-offer-container">

    <h2 class="pending-title">Validation de l'offre : {{ offer.title }}</h2>

    <form method="post" class="pending-form">

        <div class="form-group">
            <label>Titre de l'offre</label>
            <input type="text" name="title" value="{{ offer.title }}" required>
        </div>

        <div class="form-group">
            <label>Entreprise</label>
            <input type="text" value="{{ offer.company.companyName }}" disabled>
        </div>

        <div class="form-group">
            <label>Département</label>
            <input type="text" value="{{ offer.department.departmentName }}" disabled>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea name="description" rows="5" required>{{ offer.description }}</textarea>
        </div>

        <div class="form-group">
            <label>Type de contrat</label>
            <select name="offerType">
                {% for type in ['CDI','CDD','Stage','Freelance'] %}
                    <option value="{{ type }}" {{ offer.offerType == type ? 'selected' : '' }}>{{ type }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label>Niveau d'expérience</label>
            <select name="experience_level">
                {% for level in ['Junior','Intermediaire','Senior'] %}
                    <option value="{{ level }}" {{ offer.experienceLevel == level ? 'selected' : '' }}>{{ level }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label>Responsabilités</label>
            <textarea name="responsability" rows="3">{{ offer.responsability }}</textarea>
        </div>

        <div class="form-group">
            <label>Compétences (une par ligne)</label>
            <textarea name="job_skills" rows="4">{{ offer.jobSkills|join('\n') }}</textarea>
        </div>

        <div class="form-group">
            <label>Deadline</label>
            <input type="date" name="deadline" value="{{ offer.deadline ? offer.deadline|date('Y-m-d') }}">
        </div>

        <div class="form-buttons">
            <button type="submit" name="action" value="publish" class="btn btn-publish">
                Valider et publier
            </button>
            <button type="submit" name="action" value="refuse" class="btn btn-refuse">
                Refuser
            </button>
        </div>

    </form>
</div>

{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ===== FORM ===== */
.pending-offer-container {
    max-width: 760px;
    margin: 50px auto;
    background: #fff;
    padding: 32px;
    border-radius: 18px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

.pending-title {
    text-align: center;
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 28px;
}

.form-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 18px;
}

label {
    font-weight: 600;
    margin-bottom: 6px;
}

input, select, textarea {
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid #d1d5db;
    font-size: 14px;
}

input[disabled] {
    background: #f3f4f6;
}

.form-buttons {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 28px;
}

.btn {
    padding: 12px 26px;
    border-radius: 12px;
    font-weight: 700;
    border: none;
    cursor: pointer;
}

.btn-publish {
    background: #10b981;
    color: white;
}

.btn-refuse {
    background: #ef4444;
    color: white;
}

/* ===== ALERT ===== */
#alert-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

.alert-box {
    position: relative;
    background: white;
    padding: 42px 64px;
    border-radius: 22px;
    text-align: center;
    animation: scaleIn 0.3s ease;
}

.alert-box.success { color: #10b981; }
.alert-box.error { color: #ef4444; }

.icon {
    font-size: 50px;
    margin-bottom: 14px;
}

.alert-message {
    font-size: 18px;
    font-weight: 600;
}

/* Loader */
.loader-circle {
    position: absolute;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    border: 6px solid transparent;
    border-top: 6px solid #10b981;
    animation: spin 2s linear infinite;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

/* Animations */
@keyframes spin {
    to { transform: rotate(360deg) translate(-50%, -50%); }
}

@keyframes scaleIn {
    from { transform: scale(0.7); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('alert-overlay');
    if (!overlay) return;

    {% if result is defined and result == 'success' %}
        setTimeout(() => {
            window.location.href = "{{ path('dashboard_manager') }}";
        }, 2000);
    {% elseif result is defined and result == 'error' %}
        setTimeout(() => {
            overlay.remove();
        }, 1000);
    {% endif %}
});
</script>
{% endblock %}

