

{% block stylesheets %}
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

body {
    font-family: 'Inter', sans-serif;
    background: #f8fafc;
    margin: 0;
    color: #111827;
}

/* CONTAINER */
.offer-container {
    max-width: 1100px;
    margin: 60px auto;
    background: #ffffff;
    border-radius: 20px;
    padding: 50px;
    box-shadow: 0 25px 60px rgba(0,0,0,0.08);
}

/* HEADER */
.offer-header {
    position: relative;
    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(14px);
    border-radius: 18px;
    padding: 35px;
    margin-bottom: 35px;
}

.offer-title {
    font-size: 38px;
    font-weight: 700;
    margin-bottom: 8px;
}

.offer-company {
    font-size: 18px;
    font-weight: 600;
    color: #374151;
}

.offer-department {
    font-size: 14px;
    color: #6b7280;
}

/* DEADLINE */
.deadline-badge {
    position: absolute;
    top: 20px;
    right: 25px;
    background: #dc2626;
    color: #ffffff;
    padding: 8px 18px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
}

/* DATE PUBLICATION */
.publish-date {
    margin-top: 20px;
    font-size: 14px;
    color: #6b7280;
}

/* SECTIONS */
.section {
    margin-top: 40px;
}

.section h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 12px;
}

/* TEXTAREA STYLE */
.textarea-box {
    background: #f9fafb;
    border: 2px solid #000;
    border-radius: 18px;
    padding: 28px;
    min-height: 170px;
    line-height: 1.8;
    font-size: 15px;
}

/* META SMALL DIVS */
.meta-row {
    display: flex;
    gap: 20px;
    margin-top: 35px;
    flex-wrap: wrap;
}

.meta-card {
    background: #ffffff;
    border: 2px solid #000;
    border-radius: 14px;
    padding: 14px 22px;
    min-width: 220px;
}

.meta-label {
    font-size: 13px;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 6px;
}

.meta-value {
    font-size: 15px;
    font-weight: 700;
}

/* EXPERIENCE COLOR */
.meta-value.experience {
   
    color: #000000ff;
    padding: 6px 14px;
    display: inline-block;
}

/* SKILLS */
.skills-wrapper {
    margin-top: 40px;
}

.skills-box {
    background: #f9fafb;
    border: 2px solid #000;
    border-radius: 18px;
    padding: 22px;
}

.skills-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding: 0;
    margin: 0;
}

.skills-list li {
    background: #cae1e4ff;
    border: 2px solid #ffffffff;
    padding: 8px 18px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
}

/* APPLY */
.apply-btn {
    display: block;
    margin: 55px auto 0;
    width: 260px;
    padding: 16px;
    border-radius: 40px;
    background: #000;
    color: #fff;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    letter-spacing: 1px;
    transition: 0.3s;
}

.apply-btn:hover {
    background: #1f2937;
}
</style>
{% endblock %}

{% block body %}
<div class="offer-container">

    <!-- HEADER -->
    <div class="offer-header">
        <div class="offer-title">{{ jobOffer.title }}</div>

        <div class="offer-company">
            {{ jobOffer.company ? jobOffer.company.companyName : 'N/A' }}
        </div>

        <div class="offer-department">
            {{ jobOffer.department ? jobOffer.department.departmentName : 'N/A' }}
        </div>

        {% if jobOffer.deadline %}
        <div class="deadline-badge">
            Deadline : {{ jobOffer.deadline|date('d/m/Y') }}
        </div>
        {% endif %}

        <div class="publish-date">
            Publiée le {{ jobOffer.dateCreation ? jobOffer.dateCreation|date('d/m/Y') : '' }}
        </div>
    </div>

    <!-- DESCRIPTION -->
    <div class="section">
        <h3>Description du poste</h3>
        <div class="textarea-box">
            {{ jobOffer.description }}
        </div>
    </div>

    <!-- RESPONSABILITES -->
    <div class="section">
        <h3>Responsabilités</h3>
        <div class="textarea-box">
            {{ jobOffer.responsability }}
        </div>
    </div>

    <!-- META -->
    <div class="meta-row">
        <div class="meta-card">
            <div class="meta-label">Type de contrat</div>
            <div class="meta-value">
                {{ jobOffer.offerType }}
            </div>
        </div>

        <div class="meta-card">
            <div class="meta-label">Niveau d’expérience</div>
            <div class="meta-value experience">
                {{ jobOffer.experienceLevel }}
            </div>
        </div>
    </div>

    <!-- SKILLS -->
    {% if jobOffer.jobSkills is defined and jobOffer.jobSkills|length > 0 %}
    <div class="skills-wrapper">
        <h3>Compétences requises</h3>
        <div class="skills-box">
            <ul class="skills-list">
                {% for skill in jobOffer.jobSkills %}
                    <li>{{ skill }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {% endif %}

    <!-- APPLY -->
    <a href="{{ path('job_apply', {id: jobOffer.id}) }}" class="apply-btn">
        Postuler
    </a>

</div>
{% endblock %}
