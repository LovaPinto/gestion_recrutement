{# ===============================
   MENU SIDEBAR - COMPANY
   Version robuste (no error)
   =============================== #}

{# Sécurité : menus existe toujours #}
{% set menus = menus|default(['dashboard', 'departement', 'utilisateur']) %}

<aside class="sidebar">

    <h2 class="brand">Nextwork</h2>

    <nav class="menu">

        {% if 'dashboard' in menus %}
            <a href="{{ path('company_dashboard') }}">
                <i class="bx bxs-dashboard"></i>
                <span>Tableau de bord</span>
            </a>
        {% endif %}

        {% if 'departement' in menus %}
            <a href="{{ path('app_department_ajout') }}">
                <i class="bi bi-buildings-fill"></i>
                <span>Départements</span>
            </a>
        {% endif %}

        {% if 'utilisateur' in menus %}
            <a href="{{ path('users_add') }}">
                <i class="bx bxs-group"></i>
                <span>Ressources humaines</span>
            </a>
        {% endif %}

        {% if app.session.get('company') %}
            <a href="{{ path('logoutCompany') }}">
                <i class="bi bi-box-arrow-right"></i>
                <span>Déconnexion</span>
            </a>
        {% endif %}

    </nav>
</aside>
