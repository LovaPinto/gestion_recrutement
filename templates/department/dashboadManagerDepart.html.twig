{% extends 'layout/layout_frontend/layoutDepart.html.twig' %}

{% block title %}Bonjour {{ manager.firstName }}{% endblock %}

{% block body %}

<style>
/* ================= GLOBAL ================= */
.dashboard {
    padding: 32px;
    background: #fafafa;
    min-height: 100vh;
    font-family: 'Inter', system-ui, sans-serif;
    color: #111;
}

/* ================= HEADER ================= */
.dashboard-header {
    margin-bottom: 36px;
}

.dashboard-header h1 {
    font-size: 30px;
    font-weight: 700;
    margin-bottom: 4px;
}

.dashboard-header span {
    font-size: 14px;
    color: #6b7280;
}

/* ================= STATS ================= */
.stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 36px;
}

.stat {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 22px;
}

.stat-label {
    font-size: 12px;
    color: #6b7280;
    margin-bottom: 8px;
}

.stat-value {
    font-size: 30px;
    font-weight: 700;
}

/* ================= TABLE ================= */
.table-card {
    background: #fff;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
    overflow: hidden;
}

/* Header card */
.table-card-header {
    padding: 18px 22px;
    font-weight: 600;
   
}

/* Table */
.table {
    width: 100%;
    table-layout: fixed; /* 🔥 STABILITÉ */
    border-collapse: collapse;
}

/* THEAD */
.table thead {
    background: #fafafa;
}

/* ========== TABLE HEADER (MODERN) ========== */
.table thead th {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;          /* semi-bold */
    letter-spacing: 0.05em;     /* espacement élégant */
    text-transform: uppercase;  /* majuscules pro */
    color: #000000;                /* gris foncé pro */
    background: #f5f5f5;        /* léger fond de separation */
    padding: 16px 14px;
    border-bottom: 2px solid #e5e5e5; /* ligne de séparation nette */
}


/* TBODY */
.table tbody tr {
    border-bottom: 1px solid #f1f1f1;
}

.table tbody tr:last-child {
    border-bottom: none;
}

.table tbody td {
    padding: 16px 12px;
    font-size: 14px;
    vertical-align: middle;
}

/* ================= COLUMNS ================= */
.col-title    { width: 26%; text-align: left; }
.col-type     { width: 10%; text-align: center; }
.col-exp      { width: 12%; text-align: center; }
.col-created  { width: 12%; text-align: center; }
.col-deadline { width: 12%; text-align: center; }
.col-status   { width: 14%; text-align: center; }
.col-action   { width: 14%; text-align: center; } /* 🔥 rapprochée */

/* Title content */
.title {
    font-weight: 600;
    line-height: 1.4;
    white-space: normal;
    word-break: break-word;
}

/* Status */
.badge-status {
    display: inline-block;
    background: #111;
    color: #fff;
    font-size: 11px;
    padding: 5px 10px;
    border-radius: 999px;
}

/* Button */
.btn-minimal {
    display: inline-block;
    border: 1px solid #111;
    background: transparent;
    color: #111;
    padding: 5px 14px;
    font-size: 12px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
}

.btn-minimal:hover {
    background: #111;
    color: #fff;
}
</style>

<div class="dashboard">

    <!-- ================= HEADER ================= -->
    <div class="dashboard-header">
        <h1>Bonjour {{ manager.firstName }} 👋</h1>
        <span>Département — <strong>{{ department.departmentName }}</strong></span>
    </div>

    <!-- ================= STATS ================= -->
    <div class="stats">
        <div class="stat">
            <div class="stat-label">Total des offres</div>
            <div class="stat-value">{{ totalOffers }}</div>
        </div>
        <div class="stat">
            <div class="stat-label">Offres en attente</div>
            <div class="stat-value">{{ pendingOffers }}</div>
        </div>
        <div class="stat">
            <div class="stat-label">Entretiens planifiés</div>
            <div class="stat-value">{{ interviewCount }}</div>
        </div>
        <div class="stat">
            <div class="stat-label">Offres prises</div>
            <div class="stat-value">{{ takenOffers }}</div>
        </div>
    </div>

    <!-- ================= TABLE ================= -->
       <div class="table-card-header">
            Offres du département
        </div>
    <div class="table-card">
     

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th class="col-title">Titre</th>
                        <th class="col-type">Type</th>
                        <th class="col-exp">Expérience</th>
                        <th class="col-created">Créée le</th>
                        <th class="col-deadline">date limite</th>
                        <th class="col-status">Statut</th>
                        <th class="col-action">Action</th>
                    </tr>
                </thead>
                <tbody>
                {% for offer in jobOffers %}
                    <tr>
                        <td class="title col-title">{{ offer.title }}</td>
                        <td class="col-type">{{ offer.offerType }}</td>
                        <td class="col-exp">{{ offer.experienceLevel ?? '—' }}</td>
                        <td class="col-created">{{ offer.dateCreation|date('d/m/Y') }}</td>
                        <td class="col-deadline">
                            {{ offer.deadline ? offer.deadline|date('d/m/Y') : '—' }}
                        </td>
                        <td class="col-status">
                            <span class="badge-status">{{ offer.status }}</span>
                        </td>
                        <td class="col-action">
                            <a href="{{ path('offre_candidatures', { id: offer.id }) }}"
                               class="btn-minimal">
                                Voir les candidatures 
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Aucune offre disponible
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

{% endblock %}
